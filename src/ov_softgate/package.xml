<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ov_softgate</name>
  <version>1.0.0</version>
  <description>
    ov_dynamask support package: ground-truth semantic masker (VIODE segmentation
    colours), stereo ORB dynamic-object tracker, and path recorder for estimate,
    ground-truth and tracker trajectory CSV export. Works alongside the OpenVINS
    fork at Alpsource/open_vins.
  </description>
  <maintainer email="demirel.alp@gmail.com">Alp Demirel</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <exec_depend>python3-pandas</exec_depend>
    <exec_depend>python3-opencv</exec_depend>
    <build_type>ament_python</build_type>
  </export>
</package>
